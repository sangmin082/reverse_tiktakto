require "base64"

default_platform(:ios)

# MATCH_GIT_BASIC_AUTHORIZATION을 "사용자명:토큰"의 한 줄 base64로 정규화한다.
# 리눅스 base64는 76자마다 줄을 바꿔서, 긴 토큰을 그대로 넣으면 git이 HTTP 400을 낸다.
# base64(줄바꿈 포함) / "사용자명:토큰" 원문 / 토큰 단독을 모두 받는다.
def normalized_match_auth(value)
  raw = value.gsub(/\s+/, "")
  credential =
    if raw.include?(":")
      raw
    elsif raw.start_with?("ghp_", "github_pat_")
      "sangmin082:#{raw}"
    else
      Base64.decode64(raw).strip
    end
  credential = "sangmin082:#{credential}" if credential.start_with?("ghp_", "github_pat_")
  UI.user_error!("MATCH_GIT_BASIC_AUTHORIZATION은 '사용자명:토큰'의 base64여야 합니다") unless credential.include?(":")
  Base64.strict_encode64(credential)
end

PROJECT = "ReverseTicTacToe.xcodeproj"
SCHEME = "ReverseTicTacToe"
TARGET = "ReverseTicTacToe"

platform :ios do
  desc "TestFlight에 올린다. BUILD_NUMBER는 scripts/asc.py가 정한다."
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8")
    )
    app_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    ENV["MATCH_GIT_BASIC_AUTHORIZATION"] = normalized_match_auth(ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION"))

    # 새 앱이면 배포 프로파일을 만들어 인증서 저장소에 추가한다. 기존 배포 인증서를 재사용한다.
    match(api_key: api_key, app_identifier: app_id, readonly: false)

    update_code_signing_settings(
      path: PROJECT,
      targets: [TARGET],
      use_automatic_signing: false,
      team_id: ENV.fetch("sigh_#{app_id}_appstore_team-id"),
      profile_name: ENV.fetch("sigh_#{app_id}_appstore_profile-name"),
      code_sign_identity: "Apple Distribution",
      bundle_identifier: app_id
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')}",
      output_directory: "build"
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
