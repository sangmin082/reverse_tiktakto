{
  "sourceLanguage": "ko",
  "strings": {
    "'위험한 칸 표시'를 켜면 지금 두면 지는 칸에 빨간 점이 찍힙니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Show danger” to mark cells that would lose right now with a red dot."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'위험한 칸 표시'를 켜면 지금 두면 지는 칸에 빨간 점이 찍힙니다."
          }
        }
      }
    },
    "3×3과 4×4는 3개, 5×5는 4개가 한 줄이면 패배입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On 3×3 and 4×4 three in a row loses; on 5×5 it takes four."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3×3과 4×4는 3개, 5×5는 4개가 한 줄이면 패배입니다."
          }
        }
      }
    },
    "3목이면 패배": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3 in a row loses"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3목이면 패배"
          }
        }
      }
    },
