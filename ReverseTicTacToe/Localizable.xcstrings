    "위험한 칸 표시": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show danger"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위험한 칸 표시"
          }
        }
      }
    },
    "자기 말이 가로·세로·대각선으로 한 줄이 되면 그 사람이 집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your own marks form a line — across, down or diagonal — you lose."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자기 말이 가로·세로·대각선으로 한 줄이 되면 그 사람이 집니다."
          }
        }
      }
    },
    "작전 노트": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strategy Notes"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작전 노트"
          }
        }
      }
    },
    "전적 %lld승 %lld패 %lld무": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record %1$lldW %2$lldL %3$lldD"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전적 %1$lld승 %2$lld패 %3$lld무"
          }
        }
      }
    },
    "정답! 이 칸이라면 끝까지 버틸 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct! From here you can hold out to the end."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정답! 이 칸이라면 끝까지 버틸 수 있습니다."
          }
        }
      }
    },
    "정답! 이제 상대는 어디에 두든 줄이 완성됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct! Now every move your opponent has completes a line."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정답! 이제 상대는 어디에 두든 줄이 완성됩니다."
          }
        }
      }
    },
    "좋아요! 줄을 피했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nice! You avoided the line."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아요! 줄을 피했습니다."
          }
        }
      }
    },
    "줄을 만들면 진다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a Line, Lose"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄을 만들면 진다"
          }
        }
      }
    },
    "지금은 안전하지만, 상대가 잘 두면 결국 몰리게 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe for now, but with good play your opponent will corner you."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 안전하지만, 상대가 잘 두면 결국 몰리게 됩니다."
          }
        }
      }
    },
    "컴퓨터": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터"
          }
        }
      }
    },
    "컴퓨터 대전": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "vs Computer"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터 대전"
          }
        }
      }
    },
    "컴퓨터가 생각 중…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer is thinking…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터가 생각 중…"
          }
        }
      }
    },
    "판 한가운데를 기준으로 상대의 수를 뒤집어 따라 두면 웬만해선 지지 않습니다. 어느 판에서 누가 이 작전을 쓸 수 있을지 찾아보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirroring your opponent's moves through the center of the board is hard to beat. Work out on which board, and for which side, it works."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판 한가운데를 기준으로 상대의 수를 뒤집어 따라 두면 웬만해선 지지 않습니다. 어느 판에서 누가 이 작전을 쓸 수 있을지 찾아보세요."
          }
        }
      }
    },
    "판이 다 찰 때까지 아무도 줄을 만들지 않으면 무승부입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the board fills up without a line, it's a draw."
